[user]
  # Refuse to commit until a machine sets its own identity in ~/.gitconfig.local
  useConfigOnly = true

[init]
  defaultBranch = main

[core]
  editor = nvim
  excludesFile = ~/.gitignore_global

[alias]
  s = status
  a = add
  aa = add .
  c = commit
  cm = commit -m
  p = push
  pu = pull
  f = fetch
  fp = fetch -p
  fa = fetch --all
  d = diff
  ds = diff --staged
  b = branch
  ba = branch -a
  bd = branch -d
  bD = branch -D
  co = checkout
  cob = checkout -b
  lg = log --graph
  lo = log --oneline

# Load untracked, machine-specific config last so it can override anything above
[include]
  path = ~/.gitconfig.local
