# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)

# If not running interactively, don't do anything
# Prevents from being sourced on remote (rsh) or secure shell (ssh)
case $- in
    *i*) ;;
      *) return;;
esac

# --------------------------
# History Configuration
# --------------------------
HISTCONTROL=ignoreboth      # Avoid duplicate lines and lines starting with spaces
shopt -s histappend         # Append to the history file rather than overwrite
HISTSIZE=1000               # Number of history commands stored in memory
HISTFILESIZE=2000           # Number of commands stored in history file


# --------------------------
# Shell Behavior Settings
# --------------------------
shopt -s checkwinsize       # Updated LINES and COLUMNS after resizing terminal

# Make `less` more friendly for non-text input files (requires lesspipe)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# --------------------------
# Git Prompt
# --------------------------
# Load __git_ps1 from whichever git install this machine has
for git_prompt_script in \
    "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/bash_completion.d/git-prompt.sh" \
    /Library/Developer/CommandLineTools/usr/share/git-core/git-prompt.sh \
    /usr/lib/git-core/git-sh-prompt \
    /usr/share/git-core/contrib/completion/git-prompt.sh; do
    if [ -r "$git_prompt_script" ]; then
        . "$git_prompt_script"
        break
    fi
done
unset git_prompt_script

# Mark unstaged (*) and staged (+) changes, and show ahead/behind upstream (<, >, =)
GIT_PS1_SHOWDIRTYSTATE=1
GIT_PS1_SHOWUPSTREAM="auto"

# --------------------------
# Prompt Configuration
# --------------------------
# Set variable identifying the chroot you work in (used in the prompt below).
# A chroot is a Linux feature that creates an isolated environment where the system
# operates as if the root directory is different (common in dev or recovery scenarios).
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# Determine if the terminal supports color
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# Override color settings if explicitly set
if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	color_prompt=yes
    else
	color_prompt=
    fi
fi

# Configure the prompt (PS1)
# - Includes username (\u), hostname (\h), working directory (\w), and git branch
# Leave the branch out if git-prompt wasn't found, so every prompt doesn't error
git_branch_segment=''
if declare -F __git_ps1 >/dev/null; then
    git_branch_segment='$(__git_ps1 " (%s)")'
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\[\033[01;33m\]'"$git_branch_segment"'\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w'"$git_branch_segment"'\$ '
fi
unset color_prompt force_color_prompt git_branch_segment

# Set terminal title for xterm/rxvt
# - Displays user, host, and current directory in the terminal title bar
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# Setup dircolors only if available
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
fi

# --------------------------
# Aliases
# --------------------------
# Directory listings
if [[ "$OSTYPE" == "darwin"* ]]; then
    alias ls='ls -G'                                # macOS uses -G for colors
    alias aw='aerospace list-windows --workspace'   # aerospace list windows alias
else
    alias ls='ls --color=auto'  # Linux uses --color=auto for colors
fi

# Always set color support for grep
alias grep='grep --color=auto'
alias ll='ls -ltr'

# Notify when a long-running command finishes. Use like so:
#   sleep 10; alert
alert() {
    local exit_status=$?
    local last_command
    last_command=$(history 1 | sed -E 's/^ *[0-9]+ *//; s/[;&|] *alert$//')

    if [[ "$OSTYPE" == "darwin"* ]]; then
        osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "Alert"' -e 'end run' "$last_command"
        return
    fi

    local icon=terminal
    [ "$exit_status" -ne 0 ] && icon=error
    notify-send --urgency=low -i "$icon" "$last_command"
}

# --------------------------
# Load Bash Aliases
# --------------------------
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# --------------------------
# Completion Configuration
# --------------------------
if ! shopt -oq posix; then
    if [[ "$OSTYPE" == "darwin"* ]]; then
        if [ -r "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]; then
            . "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
        fi
    else
        if [ -f /usr/share/bash-completion/bash_completion ]; then
            . /usr/share/bash-completion/bash_completion
        elif [ -f /etc/bash_completion ]; then
            . /etc/bash_completion
        fi
    fi
fi

# --------------------------
# PATH Management
# --------------------------
# Function to avoid redundant PATH entries
add_to_path() {
    case ":$PATH:" in
        *":$1:"*) ;;  # Skip if already in PATH
        *) export PATH="$1:$PATH" ;;
    esac
}

# Add platform-specific paths
if [[ "$OSTYPE" == "darwin"* ]]; then
    for user_python_bin in "$HOME"/Library/Python/*/bin; do
        [ -d "$user_python_bin" ] && add_to_path "$user_python_bin"
    done
fi

# Add custom paths
for nvim_bin in /opt/nvim-linux-x86_64/bin /opt/nvim-linux64/bin; do
    [ -d "$nvim_bin" ] && add_to_path "$nvim_bin"
done
if [ -d "$HOME/.deno/bin" ]; then
    add_to_path "$HOME/.deno/bin"
fi
if [ -d "$HOME/bin" ]; then
    add_to_path "$HOME/bin"
fi
if [ -d "$HOME/.local/bin" ]; then
    add_to_path "$HOME/.local/bin"
fi

# --------------------------
# Environment Variables
# --------------------------
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                    # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm completion

# Cargo: Rust package manager and build system
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# --------------------------
# Custom Completions
# --------------------------
CODEPROMPT_COMPLETIONS=~/projects/personal/codeprompts/cli/completions/codeprompt-completions.bash
if [ -f "$CODEPROMPT_COMPLETIONS" ]; then
    . "$CODEPROMPT_COMPLETIONS"
fi
unset CODEPROMPT_COMPLETIONS

# --------------------------
# Machine-Specific Config
# --------------------------
# Load untracked, machine-specific config last so it can override anything above
if [ -f ~/.bashrc.local ]; then
    . ~/.bashrc.local
fi
